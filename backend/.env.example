# Copy this file to backend/.env and fill in your own values. backend/.env is git-ignored.
# Atlas: Database > Connect > Drivers > Python, then put your database user's password in place of <password>.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=assessment

# Optional: a real model for the verifier's extract / judge / review steps.
# Leave ASSESSMENT_MODEL_PROVIDER unset and those steps show "Not run".
# ASSESSMENT_MODEL_PROVIDER=qwen
# ASSESSMENT_MODEL=qwen3.8-flash
# DASHSCOPE_API_KEY=sk-...

# Optional: a model for the answering agent (Policy Assistant). Suggested demo
# questions stay scripted; other questions are answered from the synthetic
# library by this model. Kept separate from the verifier's model on purpose.
# AGENT_MODEL_PROVIDER=qwen
# AGENT_MODEL=qwen4-max
