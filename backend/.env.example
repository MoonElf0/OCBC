# Copy this file to backend/.env and fill in your own values. backend/.env is git-ignored.
# Atlas: Database > Connect > Drivers > Python, then put your database user's password in place of <password>.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=assessment
# No cluster reachable (e.g. IP not on the Atlas allow-list)? MONGODB_URI=memory runs an in-memory database:
# seeded fresh on every start, nothing saved. `npm run dev:full:memory` sets it for you without editing this file.

# Optional: model steps. Leave unset and model steps are reported "Not run".
# Qwen keys: Alibaba Cloud Model Studio > API keys. Set DASHSCOPE_BASE_URL only for a mainland China account
# (https://dashscope.aliyuncs.com/compatible-mode/v1).
# ASSESSMENT_MODEL_PROVIDER=qwen          # verifier: claim extraction, claim judging, answer review
# ASSESSMENT_MODEL=qwen3.8-flash
# DASHSCOPE_API_KEY=<your key>
# AGENT_MODEL_PROVIDER=qwen               # answering agent on the Assistant page (separate from the verifier)
# AGENT_MODEL=qwen4-max
